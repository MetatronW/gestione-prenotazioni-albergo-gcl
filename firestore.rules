rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {


    function isStaff() {
      return request.auth != null
        && request.auth.token.email in ['gcl.dev42@gmail.com'];
    }
    function isDemo() {
      return request.auth != null
        && request.auth.token.email == 'demo@example.com';
    }

    // ---- Validazione ------------------------------------------------
    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validRoom() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'type', 'capacity', 'pricePerNight', 'active'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 20
        && d.type in ['standard', 'superior', 'suite']
        && d.capacity is int && d.capacity >= 1 && d.capacity <= 10
        && d.pricePerNight is number && d.pricePerNight >= 0 && d.pricePerNight <= 10000
        && d.active is bool;
    }

    function validBooking() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'guestName', 'phone', 'email', 'roomId', 'checkIn', 'checkOut',
          'guestsCount', 'nights', 'pricePerNight', 'total', 'status', 'notes'
        ])
        && d.guestName is string && d.guestName.size() > 0 && d.guestName.size() <= 100
        && d.phone is string && d.phone.size() > 0 && d.phone.size() <= 30
        && d.email is string && d.email.size() <= 100
        && d.roomId is string && d.roomId.size() > 0 && d.roomId.size() <= 100
        && isDate(d.checkIn) && isDate(d.checkOut) && d.checkOut > d.checkIn
        && d.guestsCount is int && d.guestsCount >= 1 && d.guestsCount <= 10
        && d.nights is int && d.nights >= 1 && d.nights <= 30
        && d.pricePerNight is number && d.pricePerNight >= 0 && d.pricePerNight <= 10000
        && d.total is number && d.total == d.nights * d.pricePerNight
        && d.status in ['booked', 'checkedIn', 'cancelled']
        && d.notes is string && d.notes.size() <= 500;
    }

    // ---- Regole sugli stati (solo per update) -----------------------
    // Prenotata -> Arrivato, oppure Prenotata -> Annullata.
    // "Partito" non e' uno stato salvato: l'app lo ricava dalla data di check-out.
    // Le regole non possono confrontare la data di oggi, quindi il blocco delle
    // prenotazioni gia' partite vale solo nell'app.
    function validTransition() {
      let o = resource.data.status;
      let n = request.resource.data.status;
      return o == n
        || (o == 'booked' && (n == 'checkedIn' || n == 'cancelled'));
    }
    // Annullata: sola lettura (si puo' solo eliminare).
    function editable() {
      return resource.data.status in ['booked', 'checkedIn'];
    }
    // Dopo l'arrivo il check-in non si cambia.
    function checkInLocked() {
      return resource.data.status == 'booked'
        || request.resource.data.checkIn == resource.data.checkIn;
    }

    // ---- Dati reali -------------------------------------------------
    match /rooms/{id} {
      allow read, delete: if isStaff();
      allow create, update: if isStaff() && validRoom();
    }
    match /bookings/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && validBooking()
        && request.resource.data.status == 'booked';
      allow update: if isStaff() && validBooking()
        && editable() && validTransition() && checkInLocked();
      allow delete: if isStaff() && resource.data.status == 'cancelled';
    }

    // ---- Dati demo --------------------------------------------------
    // Il personale puo' svuotare le collezioni demo (serve allo script seedDemo.js).
    match /roomsDemo/{id} {
      allow read, delete: if isDemo() || isStaff();
      allow create, update: if (isDemo() || isStaff()) && validRoom();
    }
    match /bookingsDemo/{id} {
      allow read: if isDemo() || isStaff();
      allow create: if (isDemo() || isStaff()) && validBooking();
      allow update: if (isDemo() || isStaff()) && validBooking()
        && editable() && validTransition() && checkInLocked();
      allow delete: if isStaff()
        || (isDemo() && resource.data.status == 'cancelled');
    }
  }
}
